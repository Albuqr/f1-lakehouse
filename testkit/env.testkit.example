# Copie para a raiz do projeto como .env.testkit (NUNCA versione — o install.sh adiciona ao .gitignore).
# No CI, cole este conteúdo no segredo TESTKIT_ENV.
# Use contas exclusivas de teste, nunca contas reais.

# URL testada (opcional; sobrescreve web.baseUrl)
# TESTKIT_BASE_URL=https://staging.exemplo.com

# Um bloco por papel declarado em auth.roles (envPrefix + sufixo)
TESTKIT_ADMIN_USERNAME=admin@teste.exemplo.com
TESTKIT_ADMIN_PASSWORD=troque-esta-senha
# Segredo base32 do autenticador (o mesmo do QR code) ou URI otpauth://
TESTKIT_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

TESTKIT_USER_USERNAME=usuario@teste.exemplo.com
TESTKIT_USER_PASSWORD=troque-esta-senha
# E-mail que recebe link mágico/código (padrão: o próprio USERNAME)
# TESTKIT_USER_EMAIL=usuario@teste.exemplo.com

# Estratégia bearer: token fixo
TESTKIT_API_TOKEN=coloque-um-token-de-teste

# Estratégia cookie: "valor" ou "nome=valor; outro=valor"
# TESTKIT_USER_COOKIE=session=abc123

# Estratégia storage-state: sessão gravada com
#   npx playwright codegen --save-storage=auth-admin.json https://seu-site
# TESTKIT_ADMIN_STORAGE_STATE=./auth-admin.json

# Caixa de e-mail de teste (Mailpit/MailHog/endpoint próprio) para link mágico e código por e-mail
# TESTKIT_INBOX_URL=http://localhost:8025

# Cabeçalho de autenticação livre para o teste de contrato da API
# TESTKIT_API_AUTH_HEADER=X-Api-Key: chave-de-teste

# Navegador do sistema quando o download do Playwright não roda (ex.: Nix/Alpine)
# TESTKIT_CHROMIUM_PATH=/usr/bin/chromium
