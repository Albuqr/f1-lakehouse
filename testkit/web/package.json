{
  "name": "testkit-web",
  "private": true,
  "version": "1.0.0",
  "description": "Suíte genérica de testes de navegador (Playwright) do testkit",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report ../../testkit-reports/playwright-html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
